{
  "name": "marine-system",
  "version": "35.0.0",
  "description": "Marine Fleet Management System - Production Ready - Enterprise Edition",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "security": "npm audit",
    "security:fix": "npm audit fix",
    "build": "npm run lint && npm run test",
    "prestart": "npm run build",
    "deploy": "npm run build && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "sanitize-html": "^2.11.0",
    "multer": "^1.4.5-lts.1",
    "morgan": "^1.10.0",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^2.1.1",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "faker": "^5.5.3",
    "mongodb-memory-server": "^8.15.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "marine",
    "fleet",
    "management",
    "security",
    "saas",
    "enterprise",
    "mongodb",
    "express",
    "nodejs"
  ],
  "author": "الوكيل أمان الله ناجي",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/marine-system.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/marine-system/issues"
  },
  "homepage": "https://marine-system-71eo.onrender.com",
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**",
      "!**/uploads/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:node/recommended",
      "plugin:security/recommended"
    ],
    "rules": {
      "no-console": "off",
      "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "security/detect-object-injection": "off"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "printWidth": 100
  },
  "nodemonConfig": {
    "watch": ["server.js", "models/", "routes/", "middleware/"],
    "ignore": ["node_modules/", "uploads/", "logs/"],
    "ext": "js,json",
    "delay": 1000,
    "exec": "node server.js"
  }
}
