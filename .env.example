# ============================================================
# 🔐 MARINE SYSTEM v44.0 - ENVIRONMENT VARIABLES
# ============================================================

# ============================================================
# 🌍 البيئة الأساسية
# ============================================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ============================================================
# 🗄️ قاعدة البيانات
# ============================================================
MONGODB_URI=mongodb://localhost:27017/marine
MONGODB_USER=admin
MONGODB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
MONGODB_AUTH_SOURCE=admin
MONGODB_OPTIONS='{"maxPoolSize":10,"minPoolSize":2}'

# ============================================================
# 🔑 JWT (مفاتيح قوية جداً)
# ============================================================
JWT_SECRET=marine_jwt_secret_change_this_to_64_characters_long_here_2024_secure!
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=marine_refresh_secret_change_this_to_64_characters_here_2024!
REFRESH_TOKEN_EXPIRY=7d

# ============================================================
# 🔒 الأمان
# ============================================================
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
CSRF_TOKEN_SECRET=marine_csrf_secret_change_this_2024!
SECURITY_HEADERS_ENABLED=true

# ============================================================
# 📧 2FA - البريد الإلكتروني
# ============================================================
TOTP_SECRET=marine_totp_secret_change_this_2024!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=noreply@marine-system.com
SMTP_SECURE=false

# ============================================================
# 🌐 الواجهة الأمامية
# ============================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
CORS_CREDENTIALS=true

# ============================================================
# 📊 السجلات
# ============================================================
LOG_LEVEL=info
LOG_FILE=logs/combined.log
LOG_ERROR_FILE=logs/error.log
LOG_JSON_FORMAT=true

# ============================================================
# ⏰ المهام المجدولة
# ============================================================
CRON_BACKUP=0 2 * * *
CRON_CLEANUP=0 3 * * *
CRON_SESSION_CLEANUP=0 4 * * *

# ============================================================
# 📁 الملفات
# ============================================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.doc,.docx

# ============================================================
# 🚀 API
# ============================================================
API_VERSION=v1
API_PREFIX=/api
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ============================================================
# 👤 المسؤول الافتراضي
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD_123!
ADMIN_EMAIL=admin@marine-system.com
ADMIN_NAME=مدير النظام

# ============================================================
# 🛡️ Security Headers
# ============================================================
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=geolocation=(),microphone=(),camera=(),payment=()

# ============================================================
# 🔐 CSP (Content Security Policy)
# ============================================================
CSP_ENABLED=true
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self'"
CSP_STYLE_SRC="'self'"
CSP_IMG_SRC="'self' data: blob:"
CSP_FONT_SRC="'self'"
CSP_CONNECT_SRC="'self'"
CSP_OBJECT_SRC="'none'"
CSP_BASE_URI="'self'"
CSP_FRAME_ANCESTORS="'none'"
CSP_FORM_ACTION="'self'"
CSP_UPGRADE_INSECURE_REQUESTS=true

# ============================================================
# 🧪 التطوير والاختبار
# ============================================================
DEBUG=false
TEST_MODE=false
MOCK_EMAIL=false
