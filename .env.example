# ============================================================
# 🌊 MARINE SYSTEM - PRODUCTION ENVIRONMENT
# ============================================================
# 🔒 النسخة الآمنة - استخدم هذا كقالب
# ⚠️ لا تضع مفاتيح حقيقية هنا - استخدم Render Environment Variables
# ============================================================

# ============================================================
# 🚀 SERVER
# ============================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================================
# 🗄️ MONGODB ATLAS
# ============================================================
# ⚠️ استبدل USERNAME، PASSWORD، CLUSTER، DB_NAME بمفاتيحك الحقيقية
# 🔑 ضع المفتاح الحقيقي في Render Environment Variables فقط
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DB_NAME?retryWrites=true&w=majority

# ============================================================
# 🔐 JWT AUTHENTICATION
# ============================================================
# ⚠️ استخدم مفاتيح عشوائية طويلة (64 حرفاً على الأقل)
# 🔑 ضع المفاتيح الحقيقية في Render Environment Variables فقط
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET_64_CHARS_MINIMUM

# ============================================================
# 👤 ADMIN
# ============================================================
# ⚠️ استخدم كلمة مرور قوية
# 🔑 ضع كلمة المرور الحقيقية في Render Environment Variables فقط
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
ADMIN_NAME=مدير النظام

# ============================================================
# 🤖 GOOGLE GEMINI
# ============================================================
# ⚠️ احصل على مفتاح من: https://aistudio.google.com/
# 🔑 ضع المفتاح الحقيقي في Render Environment Variables فقط
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# 🌐 CORS
# ============================================================
# ⚠️ أضف رابط تطبيقك على Render
FRONTEND_URL=https://YOUR-SERVICE.onrender.com

# ============================================================
# 🛡️ SECURITY
# ============================================================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=900
PASSWORD_MIN_LENGTH=8
TRUST_PROXY=true
SECURE_COOKIES=true
HTTP_ONLY_COOKIES=true
SAME_SITE_COOKIES=strict

# ============================================================
# 🚦 RATE LIMITING
# ============================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ============================================================
# 📝 LOGGING / AUDIT
# ============================================================
LOG_LEVEL=info
ENABLE_AUDIT=true
DEBUG=false

# ============================================================
# ⚡ PERFORMANCE
# ============================================================
COMPRESSION_ENABLED=true
POOL_SIZE=20
MIN_POOL_SIZE=5
CONNECTION_TIMEOUT=10000
KEEP_ALIVE_TIMEOUT=30000
MAX_MEMORY=2048

# ============================================================
# 📊 MONITORING
# ============================================================
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# ============================================================
# 📁 FILE STORAGE
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
STORAGE_PROVIDER=external

# ============================================================
# 🔄 BACKUP
# ============================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION=7
BACKUP_PATH=./backups
AUTO_RESTORE=false

# ============================================================
# 🎨 UI
# ============================================================
DEFAULT_LANGUAGE=ar
DEFAULT_THEME=dark
RTL_ENABLED=true
SHOW_DEBUG_INFO=false

# ============================================================
# 🔔 SLACK - OPTIONAL
# ============================================================
# SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/xxx/xxx

# ============================================================
# 📧 EMAIL - OPTIONAL
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@your-domain.com
