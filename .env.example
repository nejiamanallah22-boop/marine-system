# ============================================================
# 🔐 MARINE SYSTEM - ENVIRONMENT TEMPLATE
# ============================================================
# 
# 📋 INSTRUCTIONS:
# 1. Copy this file to `.env` (without .example)
# 2. Replace all YOUR_* placeholders with real values
# 3. NEVER commit the real `.env` file to Git!
# 
# 🔑 Generate strong secrets with:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# ============================================================

# ===== البيئة =====
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ===== قاعدة البيانات =====
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE

# ===== JWT Secrets (4 مفاتيح مختلفة!) =====
JWT_SECRET=GENERATE_64_CHAR_HEX_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_CHAR_HEX_HERE
SESSION_SECRET=GENERATE_ANOTHER_64_CHAR_HEX_HERE
ENCRYPTION_KEY=GENERATE_32_BYTES_HEX_HERE_64_CHARS

# ===== المسؤول =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_STRONG_PASSWORD
ADMIN_EMAIL=your-email@example.com
ADMIN_NAME=Admin Name

# ===== الواجهة الأمامية =====
FRONTEND_URL=https://your-app.onrender.com
ALLOWED_ORIGINS=https://your-app.onrender.com

# ===== الأمان =====
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ===== اختياري =====
REDIS_URL=redis://default:PASSWORD@host:port
MAILJET_API_KEY=your-mailjet-key
MAILJET_SECRET_KEY=your-mailjet-secret
