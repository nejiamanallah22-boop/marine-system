HEALTH_CHECK_INTERVAL=60# ============================================================
# 🔐 ENCRYPTION - مطلوب (64 حرف hex)
# ============================================================
# أنشئ مفتاحاً باستخدام:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_encryption_key_here_generated_by_node_crypto

# ============================================================
# 🔑 JWT SECRET
# ============================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============================================================
# 🗄️ DATABASE - MongoDB Atlas
# ============================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/marine_db
MONGODB_USER=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_DATABASE=marine_db

# ============================================================
# ⚡ REDIS - Cache & Session Management
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_URL=redis://:your_redis_password@localhost:6379

# ============================================================
# 🤖 AI PROVIDERS (مرتبة حسب الأولوية للـ Failover)
# ============================================================

# 1️⃣ Gemini Flash (الأسرع - مجاني)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_MAX_TOKENS=4000
GEMINI_TEMPERATURE=0.7

# 2️⃣ Gemini Pro (للأسئلة المعقدة)
GEMINI_PRO_API_KEY=your_gemini_pro_api_key_here
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_PRO_MAX_TOKENS=8000

# 3️⃣ OpenAI (الأقوى - مدفوع)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7
OPENAI_ORG_ID=your_openai_org_id_here

# 4️⃣ OpenAI GPT-4 (للتحليل العميق)
OPENAI_GPT4_API_KEY=your_openai_gpt4_api_key_here
OPENAI_GPT4_MODEL=gpt-4-turbo-preview
OPENAI_GPT4_MAX_TOKENS=8000

# 5️⃣ DeepSeek (للبرمجة والتحليل الفني)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEMPERATURE=0.7

# 6️⃣ Claude (للإجابات الطويلة - مدفوع)
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=10000

# ============================================================
# ⚙️ AI CONFIGURATION
# ============================================================
AI_STRATEGY=failover  # failover | load-balance | priority
MAX_TOKENS=4000
TEMPERATURE=0.7
MAX_HISTORY_MESSAGES=15
ENABLE_CACHE=true
ENABLE_STREAMING=true
ENABLE_WEB_SEARCH=true
MAX_SEARCH_LENGTH=1000
AI_TIMEOUT=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# ============================================================
# 🎯 PREDICTIVE ANALYTICS
# ============================================================
ENABLE_PREDICTIONS=true
PREDICTION_MODEL_VERSION=5.0
FAILURE_THRESHOLD=0.7
MAINTENANCE_INTERVAL=30  # أيام
SENSOR_DATA_INTERVAL=60  # ثواني
IOT_ENABLED=true

# ============================================================
# 🔒 SECURITY
# ============================================================
BCRYPT_ROUNDS=12
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
SESSION_TIMEOUT=3600  # ثواني
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=900  # ثواني
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.com
CORS_CREDENTIALS=true

# ============================================================
# 📊 MONITORING & LOGGING
# ============================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=30
ENABLE_AUDIT=true
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=your_sentry_dsn_here

# ============================================================
# 📧 EMAIL NOTIFICATIONS
# ============================================================
ENABLE_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@marine-system.com

# ============================================================
# 🌐 SERVER
# ============================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
API_PREFIX=/api/v1
COMPRESSION_ENABLED=true
TRUST_PROXY=true
RATE_LIMIT_WINDOW=900000  # 15 دقيقة
RATE_LIMIT_MAX=100
RATE_LIMIT_PREMIUM_MAX=500
RATE_LIMIT_API_MAX=30

# ============================================================
# 🧪 TESTING
# ============================================================
TEST_ENV=false
TEST_DATABASE_URL=mongodb://localhost:27017/marine_db_test
TEST_REDIS_URL=redis://localhost:6379/1
MOCK_EXTERNAL_APIS=false

# ============================================================
# 📦 STORAGE
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
STORAGE_PROVIDER=local  # local | s3 | gcs
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=marine-fleet-data
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_KEY_FILE=./keys/google-cloud-key.json

# ============================================================
# 🎨 UI & THEMING
# ============================================================
DEFAULT_LANGUAGE=ar
DEFAULT_THEME=dark
RTL_ENABLED=true
UI_COMPACT_MODE=false
SHOW_DEBUG_INFO=false

# ============================================================
# 📱 MOBILE
# ============================================================
MOBILE_API_URL=https://api.marine-system.com
PUSH_NOTIFICATION_ENABLED=true
FCM_SERVER_KEY=your_fcm_server_key_here
APNS_KEY_ID=your_apns_key_id_here
APNS_TEAM_ID=your_apns_team_id_here
APNS_AUTH_KEY=./keys/AuthKey_XXXXXXXXXX.p8

# ============================================================
# 🔄 BACKUP & RECOVERY
# ============================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400  # يوم واحد
BACKUP_RETENTION=7  # أيام
BACKUP_PATH=./backups
AUTO_RESTORE=true

# ============================================================
# 🚀 PERFORMANCE
# ============================================================
CLUSTER_MODE=true
WORKER_COUNT=4
MAX_MEMORY=2048  # MB
GC_INTERVAL=3600  # ثواني
POOL_SIZE=20
MIN_POOL_SIZE=5
CONNECTION_TIMEOUT=10000
KEEP_ALIVE_TIMEOUT=30000

# ============================================================
# 🔍 DEBUGGING
# ============================================================
DEBUG=false
DEBUG_NAMESPACE=ai-commander:*
PROFILE_ENABLED=false
TRACE_ENABLED=false
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# ============================================================
# 💬 SLACK - للإشعارات (اختياري - مفعل يدوياً)
# ============================================================
# ⚠️ لا تضع الـ Webhook الحقيقي هنا!
# استخدم متغيرات البيئة في الخادم فقط:
# export SLACK_WEBHOOK="https://hooks.slack.com/services/xxx/xxx/xxx"
