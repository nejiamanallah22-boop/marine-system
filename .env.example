# ============================================================
# 🔐 MARINE SYSTEM - ENVIRONMENT VARIABLES
# ============================================================

# ===== البيئة =====
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ===== قاعدة البيانات =====
# (اتركها كما هي حالياً — لا نغيرها الآن)
MONGODB_URI=mongodb://localhost:27017/marine

# ===== JWT - جديد ومولّد عشوائياً =====
JWT_SECRET=الصق_هنا_الناتج_الأول_من_الخطوة_2
REFRESH_TOKEN_SECRET=الصق_هنا_الناتج_الثاني_من_الخطوة_2

# ===== الأمان (كما هو) =====
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ===== الواجهة الأمامية =====
FRONTEND_URL=https://marine-system-71eo.onrender.com
ALLOWED_ORIGINS=https://marine-system-71eo.onrender.com,http://localhost:3000

# ===== المسؤول (كما هو - يعمل حالياً) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Azerty@12345678
ADMIN_EMAIL=admin@marine-system.com
ADMIN_NAME=مدير النظام

# ===== السجلات (مغلقة) =====
LOG_LEVEL=error
LOG_ENABLED=false
SECURITY_LOG_ONLY=true
LOG_FILE=
LOG_ERROR_FILE=

# ===== إغلاق الميزات الخطرة =====
DEV_TOOLS=false
ALLOW_REGISTRATION=false
ALLOW_DEMO_ACCOUNTS=false
ALLOW_GUEST_LOGIN=false
ALLOW_SELF_REGISTER=false
ALLOW_LOG_CREATION=false
ALLOW_TEST_DATA=false

# ===== إصدار التطبيق =====
APP_VERSION=1.0.0
