# ============================================================
# 🔐 MARINE SYSTEM - ENVIRONMENT VARIABLES
# ============================================================

# ===== البيئة =====
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ===== قاعدة البيانات =====
# ⚠️ استبدل هذا برابط MongoDB Atlas حقيقي
MONGODB_URI=mongodb+srv://marine_user:PASSWORD@cluster0.xxxxx.mongodb.net/marine?retryWrites=true&w=majority

# ===== 🔑 JWT - 4 مفاتيح إلزامية =====
JWT_SECRET=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
JWT_REFRESH_SECRET=b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef1234567
SESSION_SECRET=c3d4e5f6789012345678901234567890abcdef1234567890abcdef12345678
ENCRYPTION_KEY=d4e5f6789012345678901234567890abcdef1234567890abcdef123456789

# ===== الأمان =====
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ===== الواجهة الأمامية =====
FRONTEND_URL=https://marine-system-71eo.onrender.com
ALLOWED_ORIGINS=https://marine-system-71eo.onrender.com

# ===== المسؤول =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Azerty@12345678
ADMIN_EMAIL=admin@marine-system.com
ADMIN_NAME=مدير النظام

# ===== السجلات =====
LOG_LEVEL=error
LOG_ENABLED=false
SECURITY_LOG_ONLY=true
