# ============================================================
# 🔐 MARINE SYSTEM - ENVIRONMENT VARIABLES
# ============================================================

# البيئة
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# قاعدة البيانات
MONGODB_URI=mongodb://localhost:27017/marine

# 🔑 JWT - مطلوب
JWT_SECRET=marine_jwt_secret_change_this_to_64_characters_long_here_2024_secure_2025

# 🔑 Refresh Token - مطلوب
REFRESH_TOKEN_SECRET=marine_refresh_secret_change_this_to_64_characters_here_2024_secure_2025

# الأمان
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# الواجهة الأمامية
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://marine-system-71eo.onrender.com

# المسؤول
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Azerty@12345678
ADMIN_EMAIL=admin@marine-system.com
ADMIN_NAME=مدير النظام

# السجلات
LOG_LEVEL=info
LOG_FILE=logs/combined.log
LOG_ERROR_FILE=logs/error.log
