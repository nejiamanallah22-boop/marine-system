# ============================================================
# 🔐 ENCRYPTION - مطلوب (64 حرف hex)
# ============================================================
# أنشئ مفتاحاً باستخدام:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================
# 🔑 JWT SECRET
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================================
# 🗄️ DATABASE - MongoDB Atlas
# ============================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/marine_db

# ============================================================
# 🤖 AI PROVIDERS
# ============================================================
# Gemini Flash (مجاني - مفتاحك الحقيقي)
GEMINI_API_KEY=AIzaSyALT3OlkH6UsLefQbk7j_cgD8cZVJUyXvA
GEMINI_MODEL=gemini-2.0-flash-exp

# Gemini Pro (اختياري - للأسئلة المعقدة)
# GEMINI_PRO_API_KEY=your-gemini-pro-key

# OpenAI (اختياري)
# OPENAI_API_KEY=sk-proj-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# DeepSeek (اختياري - للبرمجة)
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# ⚙️ AI CONFIGURATION
# ============================================================
MAX_TOKENS=4000
TEMPERATURE=0.7
MAX_HISTORY_MESSAGES=15
ENABLE_CACHE=true
ENABLE_STREAMING=true
ENABLE_WEB_SEARCH=true
MAX_SEARCH_LENGTH=1000

# ============================================================
# 🌐 SERVER
# ============================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
