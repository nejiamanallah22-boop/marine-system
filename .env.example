# ============================================================
# 🌊 MARINE SYSTEM - ENVIRONMENT VARIABLES v15.0
# ============================================================
# 🔐 PRODUCTION READY - SECURE EDITION
# ============================================================

# ============================================================
# 🚀 SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# ============================================================
# 🗄️ DATABASE - MongoDB Atlas
# ============================================================
# ⚠️ استبدل USERNAME و PASSWORD و CLUSTER و DB_NAME
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DB_NAME?retryWrites=true&w=majority

# ============================================================
# 🔐 JWT SECRETS - 32+ characters minimum
# ============================================================
# ⚠️ استخدم مفاتيح عشوائية طويلة
# 💡 يمكنك توليد مفتاح باستخدام:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# ============================================================
# 🌐 FRONTEND URL
# ============================================================
# ⚠️ رابط تطبيقك على Render أو Vercel
# ❌ لا تستخدم * في الإنتاج
FRONTEND_URL=https://your-app.onrender.com

# ============================================================
# 👤 ADMIN USER - Required in production
# ============================================================
# ⚠️ كلمة المرور يجب أن تكون 12 حرفاً على الأقل
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=YourStrongAdminPassword123!
ADMIN_NAME=مدير النظام

# ============================================================
# 🛡️ SECURITY SETTINGS
# ============================================================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=900
PASSWORD_MIN_LENGTH=12

# ============================================================
# 🚦 RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# ============================================================
# 📊 LOGGING
# ============================================================
LOG_LEVEL=info
ENABLE_AUDIT=true
SECURITY_LOGGING=true

# ============================================================
# ⚡ PERFORMANCE
# ============================================================
COMPRESSION_ENABLED=true
POOL_SIZE=20
MIN_POOL_SIZE=5
CONNECTION_TIMEOUT=10000
KEEP_ALIVE_TIMEOUT=30000

# ============================================================
# 📁 FILE STORAGE
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
STORAGE_PROVIDER=local

# ============================================================
# 🔄 BACKUP
# ============================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION=7
AUTO_RESTORE=false

# ============================================================
# 🎨 UI
# ============================================================
DEFAULT_LANGUAGE=ar
DEFAULT_THEME=dark
RTL_ENABLED=true
SHOW_DEBUG_INFO=false

# ============================================================
# 🤖 GEMINI AI (Optional)
# ============================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# 📧 EMAIL (Optional)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@your-domain.com

# ============================================================
# 💬 SLACK (Optional)
# ============================================================
# SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/xxx/xxx

# ============================================================
# 🔍 DEBUG - Always false in production
# ============================================================
DEBUG=false
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60
