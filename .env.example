# 🔐 متغيرات البيئة - انسخ إلى .env وقم بتعديلها

# البيئة
NODE_ENV=production
PORT=5000

# قاعدة البيانات
MONGO_ROOT_PASSWORD=change_this_strong_password
MONGODB_URI=mongodb://admin:change_this_strong_password@mongodb:27017/marine?authSource=admin

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_64_characters_long_change_this
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_secret_min_64_characters_change_this
REFRESH_TOKEN_EXPIRY=7d

# Bcrypt
BCRYPT_ROUNDS=12

# الأمان
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# الواجهة الأمامية
FRONTEND_URL=http://localhost

# البريد الإلكتروني (لإرسال 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# السجلات
LOG_LEVEL=info
