# ============================================================
# 🔐 MARINE SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in real values
# NEVER commit the real .env file!

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/marine

JWT_SECRET=your_64_char_random_hex_string_here
JWT_REFRESH_SECRET=your_64_char_random_hex_string_here
SESSION_SECRET=your_64_char_random_hex_string_here
ENCRYPTION_KEY=your_64_char_hex_string_here

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin

FRONTEND_URL=https://your-app.onrender.com
ALLOWED_ORIGINS=https://your-app.onrender.com
