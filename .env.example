# ============================================================
# 🌊 نظام إدارة الأسطول البحري - Environmental Variables
# ============================================================

# ============================================================
# 🚀 الخادم (Server)
# ============================================================
PORT=3000
NODE_ENV=development
HOST=0.0.0.0
API_VERSION=v1
API_PREFIX=/api/v1

# ============================================================
# 🗄️ قاعدة البيانات - MongoDB (Database)
# ============================================================
# للاستخدام المحلي:
# MONGODB_URI=mongodb://localhost:27017/marine_db
# للاستخدام مع MongoDB Atlas (سحابي):
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/marine_db?retryWrites=true&w=majority
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=marine_db

# ============================================================
# ⚡ Redis - التخزين المؤقت (Cache)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ============================================================
# 🔐 الأمان (Security)
# ============================================================
JWT_SECRET=marinesystem_super_secret_key_2024_secure_xyz789
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
ENCRYPTION_KEY=7f3b8a9c2d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=900
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================================
# 🌐 CORS - النطاقات المسموحة
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.com
CORS_CREDENTIALS=true

# ============================================================
# 🤖 الذكاء الاصطناعي - Gemini (AI Provider)
# ============================================================
GEMINI_API_KEY=AIzaSyALT3OlkH6UsLefQbk7j_cgD8cZVJUyXvA
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_MAX_TOKENS=4000
GEMINI_TEMPERATURE=0.7

# ============================================================
# 🤖 Gemini Pro (للأسئلة المعقدة)
# ============================================================
GEMINI_PRO_API_KEY=
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_PRO_MAX_TOKENS=8000

# ============================================================
# 🤖 OpenAI (اختياري - مدفوع)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7
OPENAI_ORG_ID=

# ============================================================
# 🤖 DeepSeek (اختياري - للبرمجة)
# ============================================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEMPERATURE=0.7

# ============================================================
# 🤖 Claude (اختياري - مدفوع)
# ============================================================
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=10000

# ============================================================
# ⚙️ إعدادات الذكاء الاصطناعي العامة
# ============================================================
AI_STRATEGY=failover
MAX_TOKENS=4000
TEMPERATURE=0.7
MAX_HISTORY_MESSAGES=15
ENABLE_CACHE=true
ENABLE_STREAMING=true
ENABLE_WEB_SEARCH=false
MAX_SEARCH_LENGTH=1000
AI_TIMEOUT=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# ============================================================
# 🎯 التحليلات التنبؤية (Predictive Analytics)
# ============================================================
ENABLE_PREDICTIONS=true
PREDICTION_MODEL_VERSION=5.0
FAILURE_THRESHOLD=0.7
MAINTENANCE_INTERVAL=30
SENSOR_DATA_INTERVAL=60
IOT_ENABLED=false

# ============================================================
# 📊 التسجيل والمراقبة (Logging & Monitoring)
# ============================================================
LOG_LEVEL=info
LOG_FORMAT=simple
LOG_RETENTION_DAYS=30
ENABLE_AUDIT=true
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=
HEALTH_CHECK_INTERVAL=60

# ============================================================
# 📧 الإشعارات عبر البريد الإلكتروني (Email)
# ============================================================
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@marine-system.com

# ============================================================
# 🌐 إعدادات الخادم الإضافية
# ============================================================
COMPRESSION_ENABLED=true
TRUST_PROXY=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_PREMIUM_MAX=500
RATE_LIMIT_API_MAX=30

# ============================================================
# 🧪 بيئة الاختبار (Testing)
# ============================================================
TEST_ENV=false
TEST_DATABASE_URL=mongodb://localhost:27017/marine_db_test
TEST_REDIS_URL=redis://localhost:6379/1
MOCK_EXTERNAL_APIS=false

# ============================================================
# 📦 التخزين والملفات (Storage)
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=marine-fleet-data
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=./keys/google-cloud-key.json

# ============================================================
# 🎨 واجهة المستخدم (UI)
# ============================================================
DEFAULT_LANGUAGE=ar
DEFAULT_THEME=dark
RTL_ENABLED=true
UI_COMPACT_MODE=false
SHOW_DEBUG_INFO=false

# ============================================================
# 📱 الإشعارات للهواتف (Mobile Push)
# ============================================================
MOBILE_API_URL=https://api.marine-system.com
PUSH_NOTIFICATION_ENABLED=false
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=./keys/AuthKey_XXXXXXXXXX.p8

# ============================================================
# 🔄 النسخ الاحتياطي (Backup)
# ============================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION=7
BACKUP_PATH=./backups
AUTO_RESTORE=true

# ============================================================
# 🚀 الأداء (Performance)
# ============================================================
CLUSTER_MODE=false
WORKER_COUNT=4
MAX_MEMORY=2048
GC_INTERVAL=3600
POOL_SIZE=20
MIN_POOL_SIZE=5
CONNECTION_TIMEOUT=10000
KEEP_ALIVE_TIMEOUT=30000

# ============================================================
# 🔍 التصحيح (Debugging)
# ============================================================
DEBUG=false
DEBUG_NAMESPACE=ai-commander:*
PROFILE_ENABLED=false
TRACE_ENABLED=false
METRICS_ENABLED=true

# ============================================================
# 💬 Slack - للإشعارات (اختياري)
# ============================================================
# SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/xxx/xxx
