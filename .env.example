# 🔐 متغيرات البيئة

# البيئة
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# قاعدة البيانات
MONGODB_URI=mongodb://localhost:27017/marine
MONGODB_USER=admin
MONGODB_PASSWORD=change_this_strong_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_64_characters_long
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_secret_min_64_characters
REFRESH_TOKEN_EXPIRY=7d

# الأمان
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
CSRF_TOKEN_SECRET=your_csrf_secret

# 2FA
TOTP_SECRET=your_totp_secret

# البريد الإلكتروني (لـ 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@marinesystem.com

# الواجهة الأمامية
FRONTEND_URL=http://localhost:3000

# السجلات
LOG_LEVEL=info
LOG_FILE=logs/combined.log

# المهام المجدولة
CRON_BACKUP=0 2 * * *
CRON_CLEANUP=0 3 * * *

# ملفات
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# API
API_VERSION=v1
API_PREFIX=/api
